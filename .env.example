MONGODB_URI=
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
SESSION_SECRET=replace-with-32-plus-random-characters
CRON_SECRET=replace-with-random-secret
APP_TIMEZONE=Asia/Tehran
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mini App authentication. Keep bot tokens server-only.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
MINI_APP_AUTH_MAX_AGE_SECONDS=600
# Bale's WebApp SDK URL supplied by the Bale developer panel/docs. Leave empty if Bale injects window.Bale.WebApp.
NEXT_PUBLIC_BALE_WEBAPP_SCRIPT_URL=
# Public deep links used by Profile's connected-account controls.
NEXT_PUBLIC_TELEGRAM_MINI_APP_URL=
NEXT_PUBLIC_BALE_MINI_APP_URL=
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_DAILY_LIMIT=100
FOOTBALL_API_DETAIL_BATCH_SIZE=20
FOOTBALL_API_MODE=current
# Set this explicitly when importing a non-current season.
FOOTBALL_API_SEASON=
