# Football Data Provider Selection: "sportsapi" (SportsAPI Pro) | "api-football" (API-Football)
# Switch the source by changing only this variable. "current" and
# "football-api" remain supported aliases for API-Football.
FOOTBALL_DATA_PROVIDER=sportsapi

# Optional Shadow / Comparison Mode: "none" | "sportsapi"
FOOTBALL_DATA_PROVIDER_SHADOW=none

# Current Provider (API-Sports / v3.football.api-sports.io)
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_DAILY_LIMIT=100
FOOTBALL_API_DETAIL_BATCH_SIZE=20
FOOTBALL_API_MODE=current
# Set this explicitly when importing a non-current season.
FOOTBALL_API_SEASON=

# SportsAPI Pro Football V2 Configuration
SPORTSAPI_API_KEY=
SPORTSAPI_DAILY_LIMIT=
SPORTSAPI_BASE_URL=https://api.sportsapipro.com/v2/football
SPORTSAPI_WS_URL=wss://api.sportsapipro.com/v2/football/ws
SPORTSAPI_WS_ENABLED=true
SPORTSAPI_STALE_MATCH_THRESHOLD_MS=90000
SPORTSAPI_RECONNECT_INITIAL_DELAY_MS=1000
SPORTSAPI_RECONNECT_MAX_DELAY_MS=30000
SPORTSAPI_DAILY_DISCOVERY_CACHE_TTL=300
# Keep false on the Free plan: daily discovery uses four REST calls; tournament
# season/event discovery can consume many additional REST requests.

# Keep false to prevent match-detail UI requests from consuming REST quota.
SPORTSAPI_TOURNAMENT_DISCOVERY_ENABLED=false
